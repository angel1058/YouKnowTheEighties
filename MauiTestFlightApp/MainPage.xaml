<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTestFlightApp.MainPage"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24" VerticalOptions="Center">

            <!-- Hero Welcome Card -->
            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0.0" />
                        <GradientStop Color="#8B5CF6" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="🚀 .NET MAUI iOS App"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Cloud CI/CD &amp; Appetize.io Preview"
                           FontSize="14"
                           TextColor="#E0E7FF"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Counter Info Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#334155"
                    StrokeThickness="1"
                    BackgroundColor="#1E293B"
                    Padding="24">

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Label Text="INTERACTIVE COUNTER DEMO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#94A3B8"
                           CharacterSpacing="1.5"
                           HorizontalTextAlignment="Center" />

                    <!-- Counter Value Display -->
                    <Label x:Name="CounterDisplay"
                           Text="0"
                           FontSize="56"
                           FontAttributes="Bold"
                           TextColor="#38BDF8"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="CounterStatus"
                           Text="Click the button below to test state &amp; UI interaction."
                           FontSize="14"
                           TextColor="#94A3B8"
                           HorizontalTextAlignment="Center" />

                    <!-- Increment Button -->
                    <Button x:Name="CounterBtn"
                            Text="Increment Counter ✨"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#6366F1"
                            CornerRadius="12"
                            HeightRequest="52"
                            Padding="24,0"
                            Clicked="OnCounterClicked"
                            HorizontalOptions="FillAndExpand" />
                </VerticalStackLayout>
            </Border>

            <!-- Deployment Status Badge -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#065F46"
                    Padding="16,12"
                    HorizontalOptions="Center">

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="⚡ status:"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#A7F3D0" />
                    <Label Text="Cloud Runner Ready (Appetize.io / TestFlight)"
                           FontSize="13"
                           TextColor="#D1FAE5" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
